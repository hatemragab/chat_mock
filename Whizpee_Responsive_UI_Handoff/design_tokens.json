  "responsiveRules": {
    "messageBubble": "Compact: max-width min(82% of usable conversation width,520px). Medium/expanded/wide: min(65%,520px). Honor text scale and wrap without clipping.",
    "form": "width: min(availableWidth - 2*gutter, 640px); centered within active content pane.",
    "discover": "Use2 compact columns with minimum120px cards. Medium+ minimum220px where fits;2medium/3expanded/4wide before reducing column count for actual available width.",
    "story": "Constrain media to aspect 9:16, maximum width420, maximum available height; letterbox rather than distort.",
    "overlay": "Phone sheets span client width and attach to bottom; medium+ center sheets up to480; attachment sheet up to640; dialogs up to420.",
    "context": "Optional 320px context pane only at >=1440; smaller widths open same destination as a route.",
    "composer": "Input border box44\u2013120px at14/20 with12px vertical padding. Pill48\u2013124px includes1px padding+1px border per side. Outer top8/bottom12 gives68\u2013144px excluding reply/emoji/host inset. Generic composerMinHeight48 is pill; composerMaxHeight144 is total outer."
  },
  "accessibility": {
    "minTouchTarget": 44,
    "focusRing": 3,
    "normalTextContrastTarget": 4.5,
    "largeTextContrastTarget": 3,
    "nonTextContrastTarget": 3,
    "textScale": "Honor system text scaling. Height tokens are minimums except layout rail width; rows/forms grow.",
    "keyboard": "Tab/Shift+Tab, Enter/Space activation; Escape closes topmost overlay; focus returns to invoker.",
    "semantics": "Every icon-only control has a semantic label; selected navigation uses selected state; live feedback uses polite announcement.",
    "colorOnly": "Selected/error/status always paired with text, icon, shape or semantics."
  },
  "refinementsFromMobileSource": [
    {
      "source": "color.light.muted #728179",
      "contract": "color.light.text.secondary #5D6F65",
      "reason": "Small readable secondary text uses improved contrast. Original #728179 retained as decorationMuted."
    },
    {
      "source": "Mixed legacy 40/43/44px controls",
      "contract": "44px minimum touch controls; 48px form fields",
      "reason": "One reusable component contract across mobile and desktop."
    },
    {
      "source": "Phone-only catalog/inspector wrapper",
      "contract": "Responsive product shell plus review-only tools",
      "reason": "Catalog and inspector are developer review surfaces, not app navigation."
    }
  ],
  "webCapabilities": {
    "calls": false,
    "videoCompression": false,
    "callHistory": true,
